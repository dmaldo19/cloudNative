aws_region        = "us-east-1"
aws_account_id    = "111122223333"
project_name      = "cloud-native-exercise"
environment       = "dev"
availability_zone = "us-east-1a"

# Creates public 10.20.0.0/24, outbound 10.20.1.0/24, and isolated 10.20.2.0/24
vpc_cidr       = "10.20.0.0/16"
subnet_newbits = 8

development_instance_type     = "t3.medium"
development_home_volume_size  = 30
development_terraform_version = "1.17.2"

# Pin a standard AL2023 x86_64 AMI in this region after reviewing the resolved AMI
# development_ami_id = "ami-..."
